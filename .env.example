# Copy to .env (git-ignored) and fill in. Read by python files/llm_config.py.
#
# Used by the content pipeline (question extraction, Phase 3), which runs on
# your machine or in a Claude Code session, not on Vercel. Never give these
# a VITE_ prefix: anything prefixed VITE_ is shipped to every browser.

# OpenRouter API key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Vision model to use. Must accept image input. Free models end in ":free",
# e.g. pick one from https://openrouter.ai/models?input_modalities=image&max_price=0
# The chosen id is recorded in every extracted file (extracted_with).
OPENROUTER_MODEL=

# Optional. Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
